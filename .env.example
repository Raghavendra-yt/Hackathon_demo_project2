# MemOS Agent Environment Configuration
# Groq API Key for LLM Working Context (openai/gpt-oss-120b)
GROQ_API_KEY=your_groq_api_key_here

# Hindsight Cloud API Key for Persistent Memory (Optional: fallback local store enabled if unset)
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# Hindsight Persistent Memory Bank ID / Team Isolation
HINDSIGHT_BANK_ID=devops-demo-team

# Server Port
PORT=8000
